# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
UPLOAD_DIR=uploaded_pdfs
# Production: openssl rand -hex 32
JWT_SECRET_KEY=supersecretlocalkey
# Session lifetime in minutes (default 480 = 8 hours). Active use auto-extends.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# docker-compose host ports (defaults avoid clashing with other local stacks on 5432/6379)
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6380

# Database (Neon / local Postgres). App converts postgresql:// → postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bcpdb

# Qdrant — local docker OR cloud URL + API key
# Local:
# QDRANT_HOST=127.0.0.1
# QDRANT_PORT=6333
# Cloud (must be https — http://…:6333 causes "404 page not found" on upload):
# QDRANT_URL=https://YOUR-CLUSTER.us-east-1-1.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key
# Aliases: QDRANT_CLUSTER_ENDPOINT / QDRANT_CLUSTER_API
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# QDRANT_URL=https://YOUR-CLUSTER.us-east-1-1.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key

# Redis / Upstash
# Prefer REDIS_URL as rediss:// from Upstash console → Connect → Redis URL
# REDIS_URL=rediss://default:YOUR_TOKEN@YOUR-ENDPOINT.upstash.io:6379
#
# If REDIS_URL is unset or still points at localhost, the app will auto-build
# rediss:// from these REST vars (same token Upstash shows for Redis password):
# UPSTASH_REDIS_REST_URL=https://YOUR-ENDPOINT.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
REDIS_URL=redis://127.0.0.1:6380/0
SEARCH_CACHE_TTL_SECONDS=3600

# Background jobs (chunk indexing + meeting transcription). Set ENABLE_JOB_QUEUE=1 and run a worker:
#   PYTHONPATH=src python -m bcp_project.jobs.worker
# or: bcp-worker  (after pip install -e .)
ENABLE_JOB_QUEUE=0
# Multi-queue workers (ingest / meeting / notify). Default on when job queue enabled.
# ENABLE_MULTI_QUEUE=1
# JOB_WORKER_QUEUES=all   # or ingest | meeting | notify | default
# JOB_QUEUE_KEY=bcp:jobs
# JOB_QUEUE_INGEST=bcp:jobs:ingest
# JOB_QUEUE_MEETING=bcp:jobs:meeting
# JOB_QUEUE_NOTIFY=bcp:jobs:notify
# JOB_PROCESSING_KEY=bcp:jobs:processing
# JOB_DEAD_LETTER_KEY=bcp:jobs:dead
# JOB_POLL_TIMEOUT=5
# JOB_MAX_ATTEMPTS=3

# Phase 1 integrator API (/api/v1) + MCP
# API_V1_RATE_LIMIT_PER_MINUTE=120
# AUDIT_EXPORT_DIR=audit_exports
# Create client:
#   PYTHONPATH=src python scripts/create_service_client.py --client-id ask-agent --name "MCP" --agent --scopes ask:sonali,docs:search,mcp:invoke
# MCP stdio server:
#   BCP_MCP_API_KEY=bcp_... BCP_MCP_ON_BEHALF=some_user PYTHONPATH=src python -m bcp_project.mcp.server

# Phase 2 bank connectors
# DOCUMENT_SOURCE=local|sftp
# DOCUMENT_INBOX_DIR=inbox_drop
# DOCUMENT_INBOX_PROCESSED_DIR=inbox_drop/processed
# SFTP_HOST= SFTP_PORT=22 SFTP_USERNAME= SFTP_PASSWORD= SFTP_REMOTE_DIR=/inbox SFTP_PROCESSED_DIR=/inbox/processed
# CUSTOMER_PORT=mock|http
# CUSTOMER_API_BASE_URL=https://cbs-facade.example/customers
# CUSTOMER_API_TOKEN=
# CUSTOMER_HEALTH_REF=DEMO-001
# WEBHOOK_URLS=https://esb.example/hooks/bcp
# WEBHOOK_SECRET=change-me
# OIDC_ENABLED=0
# OIDC_ISSUER=https://login.example
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTHORIZE_URL=
# OIDC_TOKEN_URL=
# OIDC_SCOPES=openid profile email
# OIDC_LAB_USERNAME=  (maps IdP login to a pre-provisioned local user for labs)

# Phase 3 Ask Sonali / Loan / HR stubs
# Loan/HR ports are mock allowlists until bank facades are wired.
# MOCK_LOAN_BRANCH=DHK-01
# See docs/DR.md for multi-queue + readiness drills.

# Phase A–C meeting transcription
# pip install faster-whisper
# Also install ffmpeg for best audio merge quality.
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=  (empty = auto-detect; use en or bn to force)
# Phase B: per-chunk live STT uses the same Whisper install + Redis pub/sub for captions.
# Phase C: minutes draft uses OPENAI_/OPENROUTER_ chat credentials; falls back to a Markdown template.

# Resend (meeting emails). Alias: RESEND_EMAIL_API
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev
RESEND_FROM_NAME=Sonali Bank Archive System

# LLM — prefer ONE provider on Railway (mismatched key/base_url → 401 invalid_issuer)
# Option A (recommended for Railway): OpenRouter only
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_CHAT_MODEL=openai/gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
# (leave OPENAI_API_KEY unset, or remove placeholder values)
#
# Option B: Official OpenAI only
# OPENAI_API_KEY=sk-...
# (leave OPENROUTER_API_KEY and OPENAI_BASE_URL unset)
OPENAI_API_KEY=your_openai_api_key_here
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=openai/gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Object storage
# Local demo only:
# STORAGE_BACKEND=local
# Production / Railway (required for PDF view & watermarked download):
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_ENDPOINT_URL=
AWS_BUCKET_NAME=your_bucket_name
AWS_PREFIX=pdfs
