# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
UPLOAD_DIR=uploaded_pdfs
# Production: openssl rand -hex 32
JWT_SECRET_KEY=supersecretlocalkey
# Session lifetime in minutes (default 480 = 8 hours). Active use auto-extends.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# docker-compose host ports (defaults avoid clashing with other local stacks on 5432/6379)
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6380

# Database (Neon / local Postgres). App converts postgresql:// → postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bcpdb

# Qdrant — local docker OR cloud URL + API key
# Local:
# QDRANT_HOST=127.0.0.1
# QDRANT_PORT=6333
# Cloud (must be https — http://…:6333 causes "404 page not found" on upload):
# QDRANT_URL=https://YOUR-CLUSTER.us-east-1-1.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key
# Aliases: QDRANT_CLUSTER_ENDPOINT / QDRANT_CLUSTER_API
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# QDRANT_URL=https://YOUR-CLUSTER.us-east-1-1.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key

# Redis / Upstash
# Prefer REDIS_URL as rediss:// from Upstash console → Connect → Redis URL
# REDIS_URL=rediss://default:YOUR_TOKEN@YOUR-ENDPOINT.upstash.io:6379
#
# If REDIS_URL is unset or still points at localhost, the app will auto-build
# rediss:// from these REST vars (same token Upstash shows for Redis password):
# UPSTASH_REDIS_REST_URL=https://YOUR-ENDPOINT.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
REDIS_URL=redis://127.0.0.1:6380/0
SEARCH_CACHE_TTL_SECONDS=3600
# Per-stage search timeouts; a stage that times out is skipped (keyword-only or fusion order), not fatal.
# SEARCH_EMBED_TIMEOUT_SECONDS=8
# SEARCH_VECTOR_TIMEOUT_SECONDS=5
# SEARCH_RERANK_TIMEOUT_SECONDS=4
# SEARCH_RERANK_CANDIDATES=30          # fused candidates sent to the reranker
# SEARCH_QUERY_VECTOR_CACHE=512        # in-process LRU of query embeddings
# Latency check against the real stack (target p95 < 1.5 s; run from the deploy region):
#   PYTHONPATH=src python scripts/bench_search.py
# Retrieval evaluation gates (scripts/eval_retrieval.py, run in CI):
# EVAL_MIN_RECALL=0.85
# EVAL_MIN_MRR=0.70
# EVAL_MIN_GROUNDING=0.80

# Background jobs (chunk indexing + meeting transcription). Set ENABLE_JOB_QUEUE=1 and run a worker:
#   PYTHONPATH=src python -m bcp_project.jobs.worker
# or: bcp-worker  (after pip install -e .)
ENABLE_JOB_QUEUE=0
# Jobs travel on Redis Streams with one consumer group; uploads write an outbox row
# in the same DB transaction, and the relay publishes it.
# ENABLE_MULTI_QUEUE=1
# JOB_WORKER_QUEUES=all   # or ingest | meeting | notify | default
# JOB_STREAM_DEFAULT=bcp:stream:default
# JOB_STREAM_INGEST=bcp:stream:ingest
# JOB_STREAM_MEETING=bcp:stream:meeting
# JOB_STREAM_NOTIFY=bcp:stream:notify
# JOB_STREAM_DEAD=bcp:stream:dead
# JOB_CONSUMER_GROUP=bcp-workers
# JOB_CLAIM_IDLE_MS=300000   # reclaim entries a crashed worker held this long
# JOB_POLL_TIMEOUT=5
# JOB_MAX_ATTEMPTS=3
# OUTBOX_RELAY_MODE=inline   # inline = web process relays; process = separate outbox-relay service
# INGEST_MODE=async          # async = 202 + status polling; stream = legacy NDJSON progress upload
# MAX_UPLOAD_MB=50
# MAX_IMAGE_PIXELS=120000000  # reject decompression bombs in scanned images

# OCR and verification (PDF, PNG, JPEG, TIFF uploads)
# OCR_LANGUAGES=ben+eng
# OCR_MIN_TEXT_CHARS=25        # a PDF page with less embedded text than this is OCR'd
# OCR_DESKEW=1
# OCR_REVIEW_THRESHOLD=75      # mean word confidence below this sends the upload to /review
# OCR_PAGE_REVIEW_THRESHOLD=60 # any single page below this also sends it to /review
# OCR_REVIEW_FOUR_EYES=1       # reviewer must differ from uploader (default on when APP_ENV=production)
# OCR_BANGLA_PAGE_REVIEW_THRESHOLD=92  # stricter page bar for mostly-Bangla pages (Tesseract is overconfident); default = page threshold
# OCR_BANGLA_SUSPECT_WORDS=1   # a Bangla page with this many words misread as Latin/ASCII junk goes to /review (0 = off)
# OCR_BANGLA_SUSPECT_WORD_CONF=50  # only junk words below this word confidence count as suspect
# METADATA_REVIEW=on           # route uploads to /review when AI metadata is missing or contradicts what was entered; off = auto-apply only
# OCR_RECOVER_LINES=1          # re-read ink bands Tesseract's layout analysis skipped (whole Bangla lines)
# OCR_RECOVER_MAX_BANDS=8      # cap on bands re-read per page
# OCR_MIN_INK_COVERAGE=0.9     # below this share of ink covered by recognised text, the page confidence is capped
# OCR_DETECT_LEGACY_BANGLA=1   # OCR pages whose text layer is Bijoy/SutonnyMJ ANSI-encoded Bangla

# Malware scan on upload (fails closed unless AV_SCAN_FAIL_OPEN=1)
# AV_SCAN=clamav
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT=30
# AV_SCAN_FAIL_OPEN=0

# Write-once originals on S3: needs a bucket created with Object Lock enabled
# S3_OBJECT_LOCK_DAYS=0        # 0 = off; e.g. 3650 for a ten-year retention
# S3_OBJECT_LOCK_MODE=GOVERNANCE   # or COMPLIANCE (cannot be shortened, even by root)
# Retention periods, legal hold and disposal are set in the app at /admin/retention (no env settings).
# Disposal never bypasses Object Lock: keep the lock no longer than the shortest period you dispose of.

# Multi-factor authentication (TOTP). Enforced in production for these roles.
# MFA_ENFORCE=1
# MFA_REQUIRED_ROLES=admin,board_secretary
# MFA_ENCRYPTION_KEY=   (Fernet key; python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# OIDC_TRUST_IDP_MFA=1   # accept the IdP's MFA when the ID token's amr claim asserts it (mfa/otp/hwk/...)
# AGENT_REQUIRE_ON_BEHALF_OF=1   # AI agents must name the user they act for (X-On-Behalf-Of)

# Phase 1 integrator API (/api/v1) + MCP
# API_V1_RATE_LIMIT_PER_MINUTE=120
# AUDIT_EXPORT_DIR=audit_exports
# Create client:
#   PYTHONPATH=src python scripts/create_service_client.py --client-id ask-agent --name "MCP" --agent --scopes ask:sonali,docs:search,mcp:invoke
# MCP stdio server:
#   BCP_MCP_API_KEY=bcp_... BCP_MCP_ON_BEHALF=some_user PYTHONPATH=src python -m bcp_project.mcp.server

# Phase 2 bank connectors
# DOCUMENT_SOURCE=local|sftp
# DOCUMENT_INBOX_DIR=inbox_drop
# DOCUMENT_INBOX_PROCESSED_DIR=inbox_drop/processed
# SFTP_HOST= SFTP_PORT=22 SFTP_USERNAME= SFTP_PASSWORD= SFTP_REMOTE_DIR=/inbox SFTP_PROCESSED_DIR=/inbox/processed
# CUSTOMER_PORT=mock|http
# CUSTOMER_API_BASE_URL=https://cbs-facade.example/customers
# CUSTOMER_API_TOKEN=
# CUSTOMER_HEALTH_REF=DEMO-001
# WEBHOOK_URLS=https://esb.example/hooks/bcp
# WEBHOOK_SECRET=change-me
# Single sign-on (OIDC authorization code + PKCE; the ID token is verified against the IdP JWKS)
# OIDC_ENABLED=0
# OIDC_ISSUER=https://adfs.sonalibank.local/adfs   (endpoints come from /.well-known/openid-configuration)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=          (blank for a public client; PKCE is always sent)
# OIDC_AUTHORIZE_URL= OIDC_TOKEN_URL= OIDC_JWKS_URL=   (only to override discovery)
# OIDC_SCOPES=openid profile email
# OIDC_USERNAME_CLAIM=preferred_username   (AD FS: upn or unique_name; Entra: preferred_username)
# OIDC_STRIP_DOMAIN=0          (1: "rahim@sonalibank.com.bd" -> "rahim")
# OIDC_GROUPS_CLAIM=groups
# OIDC_ROLE_MAP={"Archive-Admins":"admin","Board-Secretariat":"board_secretary","Board-Members":"board_member","Archive-Uploaders":"uploader"}
# OIDC_AUTO_PROVISION=0        (1: create the local user on first SSO sign-in; needs a mapped role)
# OIDC_ALLOWED_ALGS=RS256,PS256,ES256
# OIDC_CLOCK_SKEW_SECONDS=60
# IDENTITY_SYNC_ROLES=1        (with a role map, the directory decides the role and no mapped group = no access)

# LDAP / Active Directory password sign-in (pip install ldap3)
# LDAP_ENABLED=0
# LDAP_URL=ldaps://dc01.sonalibank.local:636
# LDAP_START_TLS=0
# LDAP_CA_FILE=/etc/ssl/certs/bank-root-ca.pem
# LDAP_BIND_DN=CN=svc-archive,OU=Service Accounts,DC=sonalibank,DC=local
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=OU=Staff,DC=sonalibank,DC=local
# LDAP_USER_FILTER=(sAMAccountName={username})
# LDAP_USERNAME_ATTR=sAMAccountName
# LDAP_ROLE_MAP={"CN=Archive-Admins,OU=Groups,DC=sonalibank,DC=local":"admin"}
# LDAP_AUTO_PROVISION=0
# LDAP_LOCAL_FALLBACK_USERS=   (break-glass local accounts allowed when LDAP rejects/is down, e.g. "admin")

# JWT signing key rotation: set the new JWT_SECRET_KEY and keep the old one here for one session lifetime
# JWT_SECRET_KEY_PREVIOUS=

# Phase 3 Ask Sonali / Loan / HR stubs
# Loan/HR ports are mock allowlists until bank facades are wired.
# MOCK_LOAN_BRANCH=DHK-01
# See docs/DR.md for multi-queue + readiness drills.

# Phase A–C meeting transcription
# pip install faster-whisper
# Also install ffmpeg for best audio merge quality.
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=  (empty = auto-detect; use en or bn to force)
# Phase B: per-chunk live STT uses the same Whisper install + Redis pub/sub for captions.
# Phase C: minutes draft uses OPENAI_/OPENROUTER_ chat credentials; falls back to a Markdown template.

# Minutes workflow: draft -> in_review -> approved (locked). Only approved minutes are archived
# (document MIN-<meeting id>, a new version per amendment) and indexed for search.
# MINUTES_FOUR_EYES=                    # empty = on in production; approver must differ from submitter and last editor
# MINUTES_BANGLA_FONT=/usr/share/fonts/truetype/lohit-bengali/Lohit-Bengali.ttf   # TTF for Bangla in the minutes PDF
# MINUTES_LATIN_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf             # TTF Latin face, needed for Bangla shaping
# MINUTES_LATIN_BOLD_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Recorded-file upload (audio or video recorded on another device). ffmpeg converts it to 16 kHz mono WAV.
# The web and worker services must share UPLOAD_DIR (a Railway volume), as for live chunks.
# MEETING_RECORDING_MAX_MB=500
# MEETING_RECORDING_FFMPEG_TIMEOUT=1800
# Speaker diarization (optional): none | pyannote | http
# DIARIZATION_PROVIDER=none
# DIARIZATION_MODEL=pyannote/speaker-diarization-3.1   # pyannote: requirements-diarization.txt on the worker (Docker: WITH_DIARIZATION=1); HF_TOKEN, or a local config.yaml path
# HF_TOKEN=                                            # Hugging Face token with the pyannote model terms accepted (not needed for a local path)
# DIARIZATION_URL=http://diarize.internal:8000/diarize # http: bank-hosted service returning {"turns":[{"start","end","speaker"}]}
# DIARIZATION_TOKEN=
# DIARIZATION_TIMEOUT=600

# Board-paper briefings: eight cited headings, ai_draft -> management_reviewed -> approved.
# Long papers are read in page-aligned windows (map) and merged (reduce); no truncation.
# Points whose quote is not on the paper are dropped. Route the board_brief AI task to a
# local model if restricted papers must be briefed (egress policy blocks cloud models).
# BRIEFING_FOUR_EYES=                   # empty = on in production; approver must differ from reviewer and last editor
# BRIEFING_WINDOW_CHARS=24000           # characters per map window
# BRIEFING_MAX_WINDOWS=16               # windows per paper; beyond this, evenly spaced windows are used
# BRIEFING_MAP_CONCURRENCY=3

# Phase 8: tamper-evident audit log + SIEM
# AUDIT_SEAL_INTERVAL_SECONDS=30        # how often new audit rows are hash-chained (one replica at a time)
# AUDIT_SEAL_DELAY_SECONDS=2            # rows younger than this wait for the next pass (in-flight commits)
# SIEM_ENABLED=0
# SIEM_FORMAT=cef                       # cef | json
# SIEM_TRANSPORT=tls                    # udp | tcp | tls | http
# SIEM_HOST=siem.sonalibank.local
# SIEM_PORT=6514
# SIEM_CA_FILE=/etc/ssl/certs/bank-root-ca.pem
# SIEM_HTTP_URL=                        # e.g. Splunk HEC / Elastic ingest endpoint (NDJSON)
# SIEM_HTTP_TOKEN=
# SIEM_HTTP_AUTH_SCHEME=Bearer          # Splunk HEC: Splunk
# SIEM_REQUIRE_SEALED=1                 # forward only rows already in the hash chain
# SIEM_START_ID=0                       # first audit id to forward on a fresh install

# Phase 8: rate limits (requests per user or service key per minute; 0 disables)
# RATE_LIMIT_SEARCH_PER_MINUTE=60
# RATE_LIMIT_ASK_PER_MINUTE=20
# RATE_LIMIT_UPLOAD_PER_MINUTE=30
# RATE_LIMIT_AI_JOB_PER_MINUTE=10
# RATE_LIMIT_RECORDING_PER_MINUTE=6
# RATE_LIMIT_API_V1_PER_MINUTE=120
# API_KEY_CACHE_SECONDS=300             # verified service keys skip bcrypt for this long
# Client IP for lockouts, rate limits and audit = the X-Forwarded-For entry this many hops from the right.
# 1 = one reverse proxy or load balancer in front (Railway edge, nginx); 2 = load balancer + nginx.
# TRUSTED_PROXY_HOPS=1
# FORWARDED_ALLOW_IPS=*                 # uvicorn: peers whose X-Forwarded-* headers are honoured; on-prem set the proxy's IP

# Monitoring (docs/evidence/monitoring.md, deploy/observability.compose.yml)
# METRICS_TOKEN=                        # bearer token for /metrics; without it /metrics is 404 in production
# METRICS_PORT=9108                     # workers and outbox relay serve /metrics here (unset = off)
# METRICS_HOST=0.0.0.0
# METRICS_MULTIPROC_DIR=/tmp/bcp-metrics  # per-process counters merged into one /metrics (set in the image)
# GRAFANA_ADMIN_PASSWORD=               # only for the monitoring compose stack

# Phase 8: connection pools and vector index
# SERVICE_ROLE=web                      # web | worker | pipeline (picks pool defaults)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800
# QDRANT_HNSW_M=16
# QDRANT_HNSW_EF_CONSTRUCT=128
# QDRANT_SEARCH_HNSW_EF=                # blank = Qdrant default; raise for recall, lower for latency
# QDRANT_UPSERT_BATCH=32
# EMBED_BATCH_SIZE=64

# Phase 8: watermarked PDF delivery
# PDF_STAMP_CACHE_MB=128                # per replica; stamped copies are per user
# PDF_STAMP_CACHE_SECONDS=300
# Document summaries use the same map-reduce instead of a 60k-character cut.
# SUMMARY_MAX_WINDOWS=12
# SUMMARY_MAP_CONCURRENCY=3

# Resend (meeting emails). Alias: RESEND_EMAIL_API
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev
RESEND_FROM_NAME=Sonali Bank Archive System

# LLM — prefer ONE provider on Railway (mismatched key/base_url → 401 invalid_issuer)
# Option A (recommended for Railway): OpenRouter only
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_CHAT_MODEL=openai/gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
# (leave OPENAI_API_KEY unset, or remove placeholder values)
#
# Option B: Official OpenAI only
# OPENAI_API_KEY=sk-...
# (leave OPENROUTER_API_KEY and OPENAI_BASE_URL unset)
OPENAI_API_KEY=your_openai_api_key_here
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=openai/gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# AI provider routing (docs/AI_PROVIDERS.md). Providers: openai | openrouter | local | stub
# Unset = the OpenAI/OpenRouter settings above, exactly as before.
# AI_CHAT_PROVIDER=openrouter
# AI_CHAT_MODEL=openai/gpt-4.1-mini
# AI_TASK_SUMMARY_PROVIDER=local        # per task: SUMMARY, MINUTES, ASK, BOARD_BRIEF, METADATA
# AI_TASK_SUMMARY_MODEL=qwen2.5:14b-instruct
# AI_EMBED_PROVIDER=openai              # changing the embedding model needs scripts/reindex_embeddings.py
# AI_EMBED_MODEL=text-embedding-3-small
# AI_EMBED_DIM=1536
# AI_RERANK_PROVIDER=none               # none | stub | local (TEI /rerank) | openai | openrouter
# AI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# AI_STT_PROVIDER=local_whisper         # local_whisper | openai_whisper | local | none
# AI_EGRESS=cloud_allowed               # cloud_allowed | restricted_local_only | internal_only
# AI_REGISTRY_REFRESH_SECONDS=30
# AI_ROUTE_FOUR_EYES=0                  # 1: route switch/reset/rollback waits for a second admin (recommended in production)
# Bank-hosted OpenAI-compatible servers (vLLM, Ollama, llama.cpp, TEI):
# LOCAL_LLM_BASE_URL=http://vllm.internal:8000/v1
# LOCAL_LLM_MODEL=qwen2.5:14b-instruct
# LOCAL_LLM_API_KEY=
# LOCAL_EMBED_BASE_URL=http://tei-embed.internal:8080/v1
# LOCAL_EMBED_MODEL=bge-m3
# LOCAL_RERANK_BASE_URL=http://tei-rerank.internal:8080
# MEETING_SENSITIVITY=confidential      # classification used for transcripts and minutes
# CONNECTOR_SENSITIVITY=internal        # classification for documents pulled from the inbox/SFTP

# Object storage
# Local demo only:
# STORAGE_BACKEND=local
# Production / Railway (required for PDF view & watermarked download):
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_ENDPOINT_URL=
AWS_BUCKET_NAME=your_bucket_name
AWS_PREFIX=pdfs

# Backups and DR drills (docs/DR.md). Keep BACKUP_ENCRYPTION_KEY in the vault, never next to the backups.
# BACKUP_ENCRYPTION_KEY=       # base64 of 32 bytes: python scripts/dr_backup.py keygen
# BACKUP_DIR=var/dr
# BACKUP_OBJECTS=manifest      # none | manifest (hashes only) | full (encrypted copy of every original)
# BACKUP_UPLOAD_URL=s3://bucket/prefix
# BACKUP_KEEP=14               # newest local backups kept; 0 keeps all
# DRILL_OPERATOR=              # name written into drill records
# DRILL_TOKEN=                 # bearer token of a test admin user for the failover drill smoke tests

# Accuracy benchmarks (scripts/bench_accuracy.py ask)
# BENCH_BASE_URL=http://127.0.0.1:8000
# BENCH_TOKEN=                 # bearer token used when a sample names no user
# BENCH_TOKENS={"member": "...", "secretary": "..."}

# React PWA (Phase 9) — served by FastAPI under /app from frontend/dist (built in the Docker frontend stage).
# Screens that have reached parity; Jinja navigations to them redirect to /app. ?classic=1 always keeps Jinja.
# Order of rollout: search (with Ask), viewer, review, meetings, briefing, admin — or "all".
# UI_REACT_SCREENS=search,viewer
# FRONTEND_DIST=/app/frontend/dist
