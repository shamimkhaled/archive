{
  "id": "/",
  "name": "Sonali Bank Archive",
  "short_name": "Sonali Archive",
  "description": "Find Board papers, meetings and decisions for Sonali Bank PLC.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F4F5FA",
  "theme_color": "#1A1A54",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/static/icons/icon-any-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-any-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/icons/icon-monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "screenshots": [
    { "src": "/static/img/screenshots/home-narrow.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Home: your next Board meeting and what needs your attention" },
    { "src": "/static/img/screenshots/home-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Home on a computer" }
  ],
  "shortcuts": [
    {
      "name": "Search the archive",
      "short_name": "Search",
      "description": "Find a document by its words, number or date",
      "url": "/search?source=pwa",
      "icons": [{ "src": "/static/icons/icon-any-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Meetings",
      "short_name": "Meetings",
      "description": "Your Board meetings",
      "url": "/meetings?source=pwa",
      "icons": [{ "src": "/static/icons/icon-any-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Upload a document",
      "short_name": "Upload",
      "description": "Add a document to the archive",
      "url": "/upload?source=pwa",
      "icons": [{ "src": "/static/icons/icon-any-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
