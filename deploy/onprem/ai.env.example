# Copy to ai.env on the GPU host (keep it out of git). Sizing: docs/evidence/sizing.md.

LOCAL_LLM_API_KEY=change-me-long-random
MODEL_DIR=/srv/models

# Chat model (vLLM). 14B fits one 48 GB GPU at 32k context; 32B needs two (LLM_TP=2, LLM_GPUS=0,1).
LLM_MODEL_DIR=Qwen2.5-14B-Instruct
LLM_SERVED_NAME=qwen2.5-14b-instruct
LLM_TP=1
LLM_GPUS=0
LLM_MAX_LEN=32768
LLM_GPU_UTIL=0.90
LLM_MAX_SEQS=32

# Embeddings and reranking (TEI) share a second GPU with Whisper.
EMBED_MODEL_DIR=bge-m3
RERANK_MODEL_DIR=bge-reranker-v2-m3
EMBED_GPUS=1

# Speech-to-text (OpenAI-compatible faster-whisper server).
WHISPER_MODEL=Systran/faster-whisper-large-v3
WHISPER_COMPUTE_TYPE=float16
WHISPER_GPUS=1

# Speaker identification on the meeting worker (set these in the worker's environment).
# pyannote: build the worker with --build-arg WITH_DIARIZATION=1. The model is gated on Hugging
# Face: accept its terms once, then either set HF_TOKEN or point DIARIZATION_MODEL at a local copy
# (a config.yaml path under MODEL_DIR) so the worker never needs internet access.
# DIARIZATION_PROVIDER=pyannote
# DIARIZATION_MODEL=/srv/models/pyannote-speaker-diarization-3.1/config.yaml
# HF_TOKEN=
# http: a diarization service on bank hardware returning {"turns": [{"start", "end", "speaker"}]}.
# DIARIZATION_PROVIDER=http
# DIARIZATION_URL=http://ai-gateway:8088/diarize
# DIARIZATION_TOKEN=change-me
# DIARIZATION_TIMEOUT=600

# Images: replace tags with digests from the bank registry.
# VLLM_IMAGE=registry.sbl.local/vllm/vllm-openai@sha256:...
# TEI_IMAGE=registry.sbl.local/huggingface/text-embeddings-inference@sha256:...
# WHISPER_IMAGE=registry.sbl.local/speaches-ai/speaches@sha256:...

AI_GATEWAY_BIND=127.0.0.1
ARCHIVE_NETWORK=sbl-archive
